    "Picks a decoder that can handle the file, and falls back when it cannot.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picks a decoder that can handle the file, and falls back when it cannot."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动挑选能解码该文件的解码器，无法处理时回退。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動挑選能解碼該檔案的解碼器，無法處理時回退。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "自動挑選能解碼該檔案的解碼器，無法處理時回退。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "自動挑選能解碼該檔案的解碼器，無法處理時回退。"
          }
        }
      }
    },
