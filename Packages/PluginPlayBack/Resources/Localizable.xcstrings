{
  "sourceLanguage" : "en",
  "strings" : {
    "A unified playback engine with playback-state management." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A unified playback engine with playback-state management."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "统一播放引擎与播放状态管理。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "統一的播放引擎與播放狀態管理。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "統一的播放引擎與播放狀態管理。"
          }
        }
      }
    },
    "After relaunch, automatically restores the last played file (loaded but not auto-played)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After relaunch, automatically restores the last played file (loaded but not auto-played)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用重启后，自动恢复上次播放的文件（仅加载，不自动播放）。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新啟動後，自動恢復上次播放的檔案（僅載入，不自動播放）。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新啟動後，自動恢復上次播放的檔案（僅載入，不自動播放）。"
          }
        }
      }
    },
    "Automatically used whenever music or audiobook content is played." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
