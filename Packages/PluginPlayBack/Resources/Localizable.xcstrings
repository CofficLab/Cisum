    "Provides a unified playback engine that controls audio playback and restores the last played file after relaunch." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provides a unified playback engine that controls audio playback and restores the last played file after relaunch."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提供统一的播放引擎，负责音频文件的播放控制，并在重启后恢复上次播放的文件。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提供統一的播放引擎，負責音訊檔案的播放控制，並在重新啟動後恢復上次播放的檔案。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提供統一的播放引擎，負責音訊檔案的播放控制，並在重新啟動後恢復上次播放的檔案。"
          }
        }
