    "Progress Display: shows the current position and total duration in real time." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progress Display: shows the current position and total duration in real time."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "进度显示：实时展示当前播放位置与总时长。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "進度顯示：即時顯示目前播放位置與總時長。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "進度顯示：即時顯示目前播放位置與總時長。"
          }
        }
      }
    },
    "Provides the progress bar view for the player control area, showing the current progress in real time and supporting drag to control the position." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provides the progress bar view for the player control area, showing the current progress in real time and supporting drag to control the position."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提供播放器控制区的进度条视图，实时显示当前播放进度，并支持拖动控制播放位置。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提供播放器控制區的進度列檢視，即時顯示目前播放進度，並支援拖曳控制播放位置。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提供播放器控制區的進度列檢視，即時顯示目前播放進度，並支援拖曳控制播放位置。"
          }
        }
      }
    },
    "Provides the progress bar view for the player control area." : {
