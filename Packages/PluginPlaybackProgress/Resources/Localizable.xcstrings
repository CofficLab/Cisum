      }
    },
    "The progress bar advances automatically while playing, showing the current progress." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The progress bar advances automatically while playing, showing the current progress."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放时进度条自动前进，展示当前进度。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放時進度列會自動前進，顯示目前進度。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放時進度列會自動前進，顯示目前進度。"
          }
        }
      }
    },
    "The progress bar is injected into the player control area via ControlViewProviding." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The progress bar is injected into the player control area via ControlViewProviding."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "进度条通过 ControlViewProviding 注入播放控制区。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "進度列透過 ControlViewProviding 注入播放控制區。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "進度列透過 ControlViewProviding 注入播放控制區。"
          }
        }
      }
    },
    "This plugin is a system-level capability that is always enabled and cannot be disabled." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This plugin is a system-level capability that is always enabled and cannot be disabled."
