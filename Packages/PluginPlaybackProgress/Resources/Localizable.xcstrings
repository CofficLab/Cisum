        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本插件为系统级能力，始终启用，不可停用。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此外掛程式為系統層級能力，始終啟用，不可停用。"
