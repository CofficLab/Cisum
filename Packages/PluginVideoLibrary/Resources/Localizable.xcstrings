    "Browse, organize and play the videos in your own folder." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Browse, organize and play the videos in your own folder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浏览、整理并播放你自己文件夹里的视频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "瀏覽、整理並播放你自己資料夾裡的影片。"
          }
        },
