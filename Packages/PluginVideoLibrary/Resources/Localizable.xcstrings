    "Choose the storage location in Settings. Cisum creates the video repository inside it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the storage location in Settings. Cisum creates the video repository inside it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在设置中选择存储位置，Cisum 会在该目录下建立视频仓库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在設定中選擇儲存位置，Cisum 會在該目錄下建立影片倉庫。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在設定中選擇儲存位置，Cisum 會在該目錄下建立影片倉庫。"
