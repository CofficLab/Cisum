    "Click a category chip (e.g. Music Library, Theme) to switch filters; click All again to clear." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click a category chip (e.g. Music Library, Theme) to switch filters; click All again to clear."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击分类胶囊（如「媒体库」「主题」）切换筛选；再次点击「全部」清除筛选。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按一下分類膠囊（如「媒體庫」「主題」）切換篩選；再按一下「全部」清除篩選。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按一下分類膠囊（如「媒體庫」「主題」）切換篩選；再按一下「全部」清除篩選。"
          }
        }
      }
    },
