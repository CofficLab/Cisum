    "Every plugin has an About page; plugins without a custom one show a default page based on metadata." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every plugin has an About page; plugins without a custom one show a default page based on metadata."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个插件都有关于页；未单独设计的插件会显示基于元数据的默认关于页。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個外掛程式都有關於頁；未單獨設計的外掛程式會顯示基於中繼資料的預設關於頁。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個外掛程式都有關於頁；未單獨設計的外掛程式會顯示基於中繼資料的預設關於頁。"
          }
        }
