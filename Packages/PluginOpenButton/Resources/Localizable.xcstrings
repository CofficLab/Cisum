    "Open File: shows the current file in the file manager.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open File: shows the current file in the file manager."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开文件：在文件管理器中显示当前文件。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟檔案：在檔案管理器中顯示目前檔案。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟檔案：在檔案管理器中顯示目前檔案。"
          }
        }
      }
    },
    "Quick Jump: locates the current media with one click.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick Jump: locates the current media with one click."
