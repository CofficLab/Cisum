        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在工具栏提供「打开当前」入口，快速定位当前播放文件。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在工具列提供「開啟目前」入口，快速定位目前播放的檔案。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
