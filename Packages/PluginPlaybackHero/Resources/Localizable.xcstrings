    "Provides the cover and title view for the player control area, automatically showing a cover or video frame based on the current media." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provides the cover and title view for the player control area, automatically showing a cover or video frame based on the current media."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提供播放器控制区的封面与标题展示视图，根据当前播放资源自动适配封面或视频画面。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提供播放器控制區的封面與標題顯示檢視，依目前播放資源自動顯示封面或影片畫面。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提供播放器控制區的封面與標題顯示檢視，依目前播放資源自動顯示封面或影片畫面。"
          }
        }
      }
    },
