    "Adaptive layout: shows only the title when the right cover column is hidden or space is tight." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adaptive layout: shows only the title when the right cover column is hidden or space is tight."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自适应布局：右侧封面栏可见或高度不足时仅显示标题。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自適應版面：右側封面欄可見或高度不足時僅顯示標題。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自適應版面：右側封面欄可見或高度不足時僅顯示標題。"
          }
        }
      }
    },
