    "Cisum keeps the video repository inside the storage location you chose": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cisum keeps the video repository inside the storage location you chose"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频库与音乐库、有声书库共用你在设置里选择的存储位置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "影片庫與音樂庫、有聲書庫共用你在設定裡選擇的儲存位置"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
