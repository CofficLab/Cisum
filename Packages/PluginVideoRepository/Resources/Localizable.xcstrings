    "Tag, rate and favorite videos, and rename or delete files in place.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag, rate and favorite videos, and rename or delete files in place."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为视频打标签、评分、收藏，并就地重命名或删除文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為影片加標籤、評分、收藏，並就地重新命名或刪除檔案。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
