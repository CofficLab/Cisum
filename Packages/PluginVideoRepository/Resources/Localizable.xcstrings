    "Creates the video repository inside the shared storage root, next to the music and audiobook libraries.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates the video repository inside the shared storage root, next to the music and audiobook libraries."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在共享存储根目录下建立视频仓库，与音乐库、有声书库并列。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在共用儲存根目錄下建立影片倉庫，與音樂庫、有聲書庫並列。"
          }
        },
        "zh-HK": {
